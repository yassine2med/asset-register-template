{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Facility asset",
  "type": "object",
  "required": ["asset_id", "name", "category", "building", "location", "install_year", "expected_life_years", "condition", "replacement_cost", "status"],
  "additionalProperties": false,
  "properties": {
    "asset_id": {"type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{4}$"},
    "name": {"type": "string", "minLength": 3},
    "category": {"enum": ["HVAC", "Electrical", "Plumbing", "Fire Safety", "Elevator", "Envelope", "Other"]},
    "building": {"type": "string", "minLength": 1},
    "location": {"type": "string", "minLength": 1},
    "manufacturer": {"type": "string"},
    "install_year": {"type": "integer", "minimum": 1900, "maximum": 2100},
    "expected_life_years": {"type": "integer", "minimum": 1, "maximum": 100},
    "condition": {"enum": ["Good", "Fair", "Poor"]},
    "replacement_cost": {"type": "number", "minimum": 0},
    "status": {"enum": ["Active", "Retired", "Spare"]}
  }
}
